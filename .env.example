# ── Database (required) ──────────────────────────────────────────
# Local:
DATABASE_URL="mysql://root:password@localhost:3306/task_tracker"

# Railway (pick ONE approach):
# 1) Recommended — map the MySQL plugin URL in Railway Variables:
#    DATABASE_URL=${{MySQL.MYSQL_URL}}
# 2) Or just link the MySQL service — the app also reads MYSQL_URL /
#    MYSQLHOST, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE, MYSQLPORT.

# Optional DB tuning
# DB_CONNECTION_LIMIT=5
# DB_CONNECT_TIMEOUT_MS=10000
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# ── App ──────────────────────────────────────────────────────────
PORT=3000
# HOST=0.0.0.0
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS=604800

# Optional
# CORS_ORIGIN="https://your-frontend.example"
# NODE_ENV=production
