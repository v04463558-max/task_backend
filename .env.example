# ── Database (required) ──────────────────────────────────────────
# Local MySQL — use these discrete vars (preferred):
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DATABASE=task_tracker

# Optional: full URL instead of the five vars above
# DATABASE_URL="mysql://root:password@localhost:3306/task_tracker"

# Railway:
# Set the same DB_* vars from your MySQL service, e.g.:
#   DB_HOST=${{MySQL.MYSQLHOST}}
#   DB_PORT=${{MySQL.MYSQLPORT}}
#   DB_USERNAME=${{MySQL.MYSQLUSER}}
#   DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
#   DATABASE=${{MySQL.MYSQLDATABASE}}
# Or link MySQL and the app will also read MYSQL_* / MYSQL_URL automatically.

# ── App ──────────────────────────────────────────────────────────
# Local: 3000. Railway injects PORT automatically — do not hardcode there.
PORT=3000
# HOST=0.0.0.0
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS=604800

# Optional
# CORS_ORIGIN="https://your-frontend.example"
# NODE_ENV=production
